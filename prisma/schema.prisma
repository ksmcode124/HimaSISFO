// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =========================
 * MASTER DATA (sesuai ERD)
 * =========================
 */

model kabinet {
  id_kabinet    Int      @id @default(autoincrement())
  nama_kabinet  String
  tahun_kerja   String
  visi          String?
  misi          String?
  tentang_kabinet     String?
  foto_kabinet  String?  // di ERD tertulis integer, tapi untuk url/path paling aman String
  gambar_logo   String?

  // elemen_logo   elemen_logo[]
  departemen    departemen[]
  detailAnggota detail_anggota[]
  agenda         agenda[]
  komunitas     komunitas[]
  aspirasi      aspirasi[]
  elemen_kabinet elemen_kabinet[] 

  @@map("kabinet")
}

model elemen_kabinet {
  id_elemen_kabinet   Int     @id @default(autoincrement())
  id_kabinet              Int
  nama_elemen             String
  gambar_logo             String?
  deskripsi               String?

  kabinet kabinet @relation(fields: [id_kabinet], references: [id_kabinet], onDelete: Cascade)

  @@map("elemen_kabinet")
}

model departemen {
  id_departemen             Int     @id @default(autoincrement())
  id_kabinet                Int
  nama_departemen           String
  deskripsi_departemen      String?
  logo_departemen           String?
  foto_departemen           String?

  kabinet       kabinet          @relation(fields: [id_kabinet], references: [id_kabinet], onDelete: Cascade)
  detailAnggota detail_anggota[]
  proker        proker[]
  elemen_departemen elemen_departemen[]

  @@map("departemen")
}

model elemen_departemen {
  id_elemen_departemen   Int     @id @default(autoincrement())
  id_departemen   Int
  nama_elemen     String
  gambar_logo     String?
  deskripsi       String?

  departemen departemen @relation(fields: [id_departemen], references: [id_departemen], onDelete: Cascade)

  @@map("elemen_departemen")
}

model anggota {
  id_anggota   Int    @id @default(autoincrement())
  nama_anggota String
  NIM          String?

  detailAnggota detail_anggota[]

  @@map("anggota")
}

model detail_anggota {
  id_detail_anggota     Int     @id @default(autoincrement())
  id_kabinet    Int
  id_departemen Int
  id_anggota    Int
  nama_jabatan String
  foto_anggota  String? // ERD: text

  anggota    anggota    @relation(fields: [id_anggota], references: [id_anggota], onDelete: Cascade)
  kabinet    kabinet    @relation(fields: [id_kabinet], references: [id_kabinet], onDelete: Cascade)
  departemen departemen @relation(fields: [id_departemen], references: [id_departemen], onDelete: Cascade)

  @@unique([id_anggota, id_kabinet])
  @@map("detail_anggota")
}

model proker {
  id_proker             Int     @id @default(autoincrement())
  id_departemen         Int
  id_detail_anggota     String?
  nama_proker           String
  deskripsi             String?
  foto_proker           String?

  departemen departemen @relation(fields: [id_departemen], references: [id_departemen], onDelete: Cascade)
  detail_anggota    detail_anggota    @relation(fields: [id_detail_anggota], references: [id_detail_anggota], onDelete: Cascade)

  @@map("proker")
}

model agenda {
  id_agenda        Int      @id @default(autoincrement())
  id_kabinet       Int
  kategori         String
  gambar_agenda    String?
  deskripsi        String?
  judul            String
  tanggal_mulai    DateTime
  tanggal_berakhir DateTime

  kabinet kabinet @relation(fields: [id_kabinet], references: [id_kabinet], onDelete: Cascade)

  @@map("agenda")
}

/**
 * =========================
 * KOMUNITAS (sesuai ERD terbaru)
 * =========================
 */

model komunitas {
  id_komunitas   Int     @id @default(autoincrement())
  id_kabinet     Int
  nama_komunitas  String
  foto_komunitas String? // ERD: text (bukan json)
  deskripsi       String?
  link_gabung     String?
  foto_jersey     String?

  kabinet     kabinet               @relation(fields: [id_kabinet], references: [id_kabinet], onDelete: Cascade)
  pencapaian  komunitas_pencapaian[]
  dokumentasi      dokumentasi_komunitas[]

  @@map("komunitas")
}

model dokumentasi_komunitas {
  id_dok_komunitas Int  @id @default(autoincrement())  
  id_komunitas      Int
  foto_komunitas    String
  nama_kegiatan     String

  komunitas komunitas @relation(fields: [id_komunitas], references: [id_komunitas], onDelete: Cascade)

  @@map("dokumentasi_komunitas")
}

model komunitas_pencapaian {
  id_pencapaian   Int     @id @default(autoincrement())
  id_komunitas    Int
  foto_pencapaian String? // ERD: text
  judul           String  // ERD: text (prisma tidak punya "text", pakai String)
  tanggal_pencapaian DateTime
  deskripsi       String?

  komunitas komunitas @relation(fields: [id_komunitas], references: [id_komunitas], onDelete: Cascade)

  @@map("komunitas_pencapaian")
}

model aspirasi {
  id_aspirasi     Int     @id @default(autoincrement())
  id_kabinet    Int
  nama  String?
  isi_aspirasi  String   // ERD: text
  tanggal_dibuat DateTime @default(now())

  kabinet kabinet @relation(fields: [id_kabinet], references: [id_kabinet], onDelete: Cascade)

  @@map("aspirasi")
}

/**
 * =========================
 * AUTH (biarkan seperti punyamu)
 * =========================
 */

model user {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  role          Role     @default(admin)

  accounts Account[]
  sessions Session[]
  auditLogs AuditLog[]
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  expiresAt             DateTime?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  type                  String    @default("credential")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

model AuditLog {
  id_auditlog Int @id @default(autoincrement())
  userId      String
  action      String
  module      String?
  description String?
  createdAt   DateTime @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("AuditLog")
}

enum Role {
  superadmin
  admin
}